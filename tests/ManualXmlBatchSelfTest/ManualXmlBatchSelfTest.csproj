<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/RimWorld-Auto-AI-Translation_Core/UI/Workbench/ManualXmlBatchStore.cs" Link="ManualXmlBatchStore.cs" />
    <Compile Include="../../src/RimWorld-Auto-AI-Translation_Core/Scanning/TranslationXmlAtomicFileStore.cs" Link="TranslationXmlAtomicFileStore.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath Condition="'$(TargetFramework)' == 'net48'">../../packages/Newtonsoft.Json.13.0.4/lib/net45/Newtonsoft.Json.dll</HintPath>
      <HintPath Condition="'$(TargetFramework)' == 'net10.0'">../../packages/Newtonsoft.Json.13.0.4/lib/net6.0/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
